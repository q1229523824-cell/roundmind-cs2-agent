FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY chapter07_cs2_coach/requirements.txt /tmp/roundmind-requirements.txt
RUN pip install --no-cache-dir -r /tmp/roundmind-requirements.txt

COPY chapter07_cs2_coach ./chapter07_cs2_coach

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

CMD ["sh", "-c", "uvicorn chapter07_cs2_coach.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
