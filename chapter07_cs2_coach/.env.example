# 逗号分隔，不要带末尾斜杠。
ROUNDMIND_CORS_ORIGINS=https://roundmind-cs2-coach.kclespark.chatgpt.site

# 可选。配置后比赛数据持久化到 PostgreSQL；未配置时使用内存仓库。
DATABASE_URL=

# 仅在显式启用 DeepSeek planner 时需要，切勿提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认关闭。开启后只发送匿名教练上下文和当前问题；公网使用前需要鉴权与限流。
ROUNDMIND_ENABLE_LLM_COACH=false
