# 逗号分隔，不要带末尾斜杠。
ROUNDMIND_CORS_ORIGINS=https://roundmind-cs2-coach.kclespark.chatgpt.site

# 可选。配置后比赛数据持久化到 PostgreSQL；未配置时使用内存仓库。
DATABASE_URL=

# Demo 对象存储。默认 local；Cloudflare R2 使用 r2，并填写 S3 兼容参数。
ROUNDMIND_OBJECT_STORAGE=local
ROUNDMIND_LOCAL_DEMO_DIR=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 可选分布式任务。只有同时部署 Redis、API 与 Celery Worker 后才设为 celery。
ROUNDMIND_JOB_BACKEND=local
ROUNDMIND_MAX_PENDING_JOBS=2
ROUNDMIND_DEMO_WORKERS=1
REDIS_URL=

# 单实例零成本限流；多实例部署时应替换为 Redis 原子计数。
ROUNDMIND_RATE_LIMIT_ENABLED=false
ROUNDMIND_TRUST_PROXY_HEADERS=false
ROUNDMIND_UPLOADS_PER_HOUR=6
ROUNDMIND_HEAVY_REQUESTS_PER_MINUTE=30
ROUNDMIND_AUTH_ATTEMPTS_PER_15M=10

# 可选登录与用户数据隔离。JWT Secret 至少 32 字符，只能放部署平台 Secret。
ROUNDMIND_AUTH_REQUIRED=false
ROUNDMIND_JWT_SECRET=

# 可选向量知识检索；默认 local 保持当前确定性关键词 RAG。
ROUNDMIND_KNOWLEDGE_BACKEND=local

# 仅在显式启用 DeepSeek planner 时需要，切勿提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认关闭。开启后只发送匿名教练上下文和当前问题；公网使用前需要鉴权与限流。
ROUNDMIND_ENABLE_LLM_COACH=false
